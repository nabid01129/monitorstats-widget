{
  "name": "monitorstats-widget",
  "productName": "MonitorStats Widget",
  "description": "A lightweight Windows hardware monitor for a secondary display.",
  "author": "MonitorStats",
  "private": true,
  "version": "1.3.36",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "package:win": "pnpm run build && powershell -NoProfile -ExecutionPolicy Bypass -File electron/build-fancontrol-reader.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File electron/build-foreground-monitor.ps1 && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.monitorstats.widget",
    "productName": "MonitorStats Widget",
    "directories": { "output": "release-installer" },
    "extraResources": [
      { "from": "electron/telemetry.ps1", "to": "telemetry.ps1" },
      { "from": "electron/FanControlReader.exe", "to": "FanControlReader.exe" },
      { "from": "electron/ForegroundMonitor.exe", "to": "ForegroundMonitor.exe" }
    ],
    "files": ["dist/**/*", "electron/**/*", "assets/**/*", "package.json"],
    "win": { "icon": "assets/monitorstats.ico", "target": ["nsis"], "artifactName": "MonitorStats-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MonitorStats Widget"
    }
  }
}
